{
  "name": "dsh-plugin-session-palette",
  "version": "0.3.1",
  "type": "module",
  "description": "Make Cmd+K open a Spotlight-style session palette instead of focusing the sidebar search box, with in-place renaming from the palette or from the conversation title.",
  "license": "MIT",
  "author": "Jiaxin Kou <https://hypersampling.com>",
  "icon": "./assets/icon.svg",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets/icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "palette",
    "spotlight",
    "command-palette",
    "switcher"
  ],
  "scripts": {
    "test": "node --test tests/plugin.test.mjs"
  }
}
